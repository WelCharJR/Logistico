+.kanban-bin.search-hit { box-shadow: 0 0 0 3px var(--yellow), 0 6px 18px rgba(242, 181, 29, 0.5); }
+@media (hover: hover) and (pointer: fine) { .kanban-bin:hover { transform: translateY(-3px) rotateX(3deg) scale(1.03); box-shadow: 0 8px 18px rgba(47, 85, 228, 0.3); } }
+.kanban-slot-editor { display: flex; flex-direction: column; gap: 11px; padding: 16px; border-radius: 14px; background: #f4f7fc; }
+.kanban-slot-editor h3 { margin: -2px 0 2px; font-size: 17px; font-weight: 800; color: var(--blue); }
+.kanban-slot-editor label { display: grid; gap: 5px; color: var(--muted); font-size: 11.5px; font-weight: 600; }
+.kanban-slot-editor input { width: 100%; height: 38px; padding: 0 10px; border: 1px solid var(--line-strong); border-radius: 9px; background: #fff; color: var(--ink); font: inherit; font-size: 13px; }
+.kanban-slot-editor input:focus { outline: none; border-color: var(--blue); box-shadow: 0 0 0 3px rgba(47, 85, 228, 0.12); }
+.kanban-slot-editor input:disabled { background: #f4f7fc; color: var(--muted); }
+.kanban-slot-editor > small { margin-top: auto; color: var(--muted); font-size: 11px; line-height: 1.5; }
+
+/* ---------- modo visualização ---------- */
+.log-view-only .log-site-badge { background: var(--green); }
+
+/* ---------- telas médias ---------- */
+@media (max-width: 1380px) {
+  .log-site, .log-notice { display: none; }
+  .log-search { flex: 1 1 auto; }
+  .log-kpi { min-width: 0; }
+  .log-kpi em { display: none; }
+}
+@media (max-width: 1180px) {
+  .log-kpis .log-kpi:nth-child(n + 3) { display: none; }
+  .log-track-card { width: calc(100% - 380px - 3 * var(--gap)); }
+  .log-track-item { display: none; }
+  .log-list-card { width: 380px; height: 196px; }
+  .log-row { grid-template-columns: 44px minmax(0, 1fr) auto 16px; }
+  .log-row-bar { display: none; }
+  .log-detail-card { max-height: calc(100% - 72px - 2 * var(--gap) - 216px); }
+  .log-key-help { display: none; }
+}
+
+/* ---------- celular: cena no topo, cards empilhados abaixo ---------- */
+@media (max-width: 820px) {
+  .log-app { --gap: 10px; height: auto; min-height: 100svh; overflow: visible; display: flex; flex-direction: column; }
+  .log-top { position: sticky; top: 0; z-index: 20; height: auto; flex-wrap: wrap; gap: 8px; margin: 0; padding: 10px; border-radius: 0; }
+  .log-brand { flex: 1; }
+  .log-live { display: none; }
+  .log-search { order: 3; flex: 1 1 100%; height: 44px; }
+  .log-search input { font-size: 16px; }
+  .log-actions { gap: 5px; }
+  .log-actions .log-btn { padding: 0 10px; }
+  .log-actions .log-btn.ghost { width: 38px; padding: 0; }
+  .log-actions .log-btn span { display: none; }
+  .log-stage { position: relative; inset: auto; height: clamp(380px, 60svh, 560px); flex: none; }
+  .log-kpis { position: static; order: 2; display: grid; grid-template-columns: repeat(4, minmax(140px, 1fr)); gap: 8px; padding: 10px var(--gap) 0; overflow-x: auto; pointer-events: auto; }
+  .log-kpis .log-kpi:nth-child(n) { display: flex; }
+  .log-kpi { box-shadow: 0 1px 3px rgba(24, 39, 75, 0.08); }
+  .log-tools { top: var(--gap); }
+  .log-rail button { width: 44px; height: 44px; }
+  .log-rail button span { display: none; }
+  .log-view-rail { top: var(--gap); right: var(--gap); }
+  .log-draw-card { top: var(--gap); left: calc(var(--gap) + 66px); right: calc(var(--gap) + 66px); width: auto; }
+  .log-cards { order: 3; display: grid; gap: 10px; padding: 10px var(--gap) 24px; }
+  .log-card { position: static; width: auto !important; max-height: none !important; height: auto; box-shadow: 0 1px 3px rgba(24, 39, 75, 0.08); }
+  .log-list-card { height: auto; max-height: 360px !important; }
+  .log-track-card { flex-direction: column; }
+  .log-track-item { width: auto; }
+  .log-drawer, .log-drawer-backdrop, .kanban-backdrop { position: fixed; }
+  .log-drawer { top: auto; left: 0; right: 0; bottom: 0; width: auto; max-width: none; max-height: 88svh; border-radius: 20px 20px 0 0; }
+  .log-form input, .log-form select, .kanban-slot-editor input { height: 44px; font-size: 16px; }
+  .kanban-inspect-body { grid-template-columns: minmax(0, 1fr); }
+  .kanban-rack { max-height: 43svh; }
+  .kanban-slot-editor { display: grid; grid-template-columns: 1fr 1fr; align-items: end; }
+  .kanban-slot-editor > .log-eyebrow, .kanban-slot-editor h3, .kanban-slot-editor > small { grid-column: 1 / -1; }
+}
+@media (max-width: 420px) {
+  .log-brand small { display: none; }
+  .log-steps small { display: none; }
+  .kanban-slot-editor { grid-template-columns: 1fr; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .log-app *, .log-app *::before, .log-app *::after { animation: none !important; transition: none !important; }
+}
