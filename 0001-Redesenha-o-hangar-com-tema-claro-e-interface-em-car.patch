+/* =========================================================================
+   Hangar Digital · tema claro
+   A cena 3D ocupa a tela inteira; a interface flutua por cima em cards.
+   ========================================================================= */
+.log-app {
+  --bg: #e4ebf5;
+  --card: rgba(255, 255, 255, 0.94);
+  --line: #e4e9f2;
+  --line-strong: #d3dbe8;
+  --ink: #1d2433;
+  --muted: #6b7487;
+  --faint: #98a2b5;
+  --blue: #2f55e4;
+  --blue-2: #3a63ef;
+  --blue-soft: #eaf0ff;
+  --green: #1f9d5c;
+  --green-soft: #e3f6ec;
+  --yellow: #f2b51d;
+  --red: #d64545;
+  --radius: 16px;
+  --shadow: 0 1px 2px rgba(24, 39, 75, 0.06), 0 10px 30px rgba(24, 39, 75, 0.1);
+  --gap: 14px;
+  position: relative;
+  height: 100svh;
+  min-height: 620px;
+  overflow: hidden;
+  background: var(--bg);
+  color: var(--ink);
+  font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
+  font-size: 13px;
+  -webkit-font-smoothing: antialiased;
 }
+.log-app button { font: inherit; color: inherit; cursor: pointer; }
+.log-app button:disabled { cursor: not-allowed; opacity: 0.45; }
+.log-app :focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
+.log-eyebrow { display: block; font-size: 10.5px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--faint); }
+.log-empty { margin: 0; padding: 12px 4px; color: var(--muted); font-size: 12px; }
+
+/* ---------- botões ---------- */
+.log-btn { display: inline-flex; align-items: center; justify-content: center; gap: 7px; height: 38px; padding: 0 14px; border-radius: 10px; border: 1px solid transparent; font-weight: 650; font-size: 13px; white-space: nowrap; transition: background-color 0.15s, border-color 0.15s, transform 0.15s; }
+.log-btn.primary { background: var(--blue); color: #fff; box-shadow: 0 4px 12px rgba(47, 85, 228, 0.28); }
+.log-btn.primary:hover:not(:disabled) { background: #2649cc; }
+.log-btn.ghost { background: #fff; border-color: var(--line-strong); color: var(--ink); }
+.log-btn.ghost:hover { border-color: var(--blue); color: var(--blue); }
+.log-btn.danger { background: #fff1f1; color: var(--red); border-color: #f6d0d0; }
+.log-btn.danger:hover { background: #ffe4e4; }
+.log-btn.wide { width: 100%; }
+.log-icon-btn { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 10px; border: 1px solid var(--line-strong); background: #fff; color: var(--faint); transition: all 0.15s; }
+.log-icon-btn.on { color: var(--blue); background: var(--blue-soft); border-color: #cdd9ff; }
+.log-icon-btn.on.view { color: #fff; background: var(--green); border-color: var(--green); }
+.log-icon-btn:hover { border-color: var(--blue); }
+.log-close { display: grid; place-items: center; width: 30px; height: 30px; flex: none; border-radius: 8px; border: 1px solid var(--line); background: #fff; color: var(--muted); }
+.log-close:hover { color: var(--ink); border-color: var(--line-strong); }
+
+/* ---------- cena ---------- */
+.log-stage { position: absolute; inset: 0; }
+.log-canvas { position: absolute; inset: 0; overscroll-behavior: contain; touch-action: none; }
+.log-canvas canvas { width: 100%; height: 100%; display: block; cursor: grab; }
+.log-canvas canvas:active { cursor: grabbing; }
+
+/* ---------- barra superior ---------- */
+.log-top { position: absolute; z-index: 10; top: var(--gap); left: var(--gap); right: var(--gap); height: 60px; display: flex; align-items: center; gap: 14px; padding: 0 12px 0 16px; background: var(--card); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.8); border-radius: var(--radius); box-shadow: var(--shadow); }
+.log-brand { display: flex; align-items: center; gap: 10px; flex: none; }
+.log-brand b { display: block; font-size: 15px; font-weight: 800; letter-spacing: -0.01em; }
+.log-brand small { display: block; font-size: 11px; color: var(--muted); }
+.log-logo { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; color: #fff; background: linear-gradient(135deg, #4c72ff, #2340c4); box-shadow: 0 4px 10px rgba(47, 85, 228, 0.35); }
+.log-search { position: relative; flex: 0 1 380px; min-width: 200px; display: flex; align-items: center; gap: 8px; height: 40px; padding: 0 10px 0 12px; border-radius: 11px; background: #f3f6fb; border: 1px solid var(--line); color: var(--faint); }
+.log-search:focus-within { background: #fff; border-color: var(--blue); box-shadow: 0 0 0 3px rgba(47, 85, 228, 0.12); }
+.log-search input { flex: 1; min-width: 0; height: 100%; border: 0; background: transparent; color: var(--ink); font: inherit; font-size: 13px; outline: none; }
+.log-search input::placeholder { color: var(--faint); }
+.log-search-clear { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 6px; border: 0; background: #e5eaf3; color: var(--muted) !important; }
+.log-search-results { position: absolute; top: calc(100% + 8px); left: 0; right: 0; z-index: 30; display: grid; gap: 2px; max-height: 360px; overflow: auto; padding: 10px 6px 6px; background: #fff; border: 1px solid var(--line); border-radius: 14px; box-shadow: 0 18px 40px rgba(24, 39, 75, 0.18); }
+.log-search:not(:focus-within) .log-search-results { display: none; }
+.log-search-results > .log-eyebrow { padding: 0 8px 6px; }
+.log-search-results > button { display: grid; grid-template-columns: 32px minmax(0, 1fr) auto; align-items: center; gap: 10px; padding: 8px; border: 0; border-radius: 10px; background: transparent; text-align: left; }
+.log-search-results > button:hover, .log-search-results > button:focus-visible { background: var(--blue-soft); }
+.log-result-icon { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 9px; background: var(--blue-soft); color: var(--blue); }
+.log-search-results b { display: block; font-size: 13px; color: var(--ink); }
+.log-search-results span small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 11.5px; color: var(--muted); }
+.log-search-results em { font-style: normal; text-align: right; font-size: 11.5px; font-weight: 700; color: var(--blue); }
+.log-search-results em small { display: block; font-weight: 500; color: var(--muted); }
+.log-notice { flex: 1 1 auto; min-width: 0; margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--muted); font-size: 12px; }
+.log-site { display: flex; align-items: center; gap: 9px; flex: none; padding: 5px 12px 5px 5px; border: 1px solid var(--line); border-radius: 11px; background: #fff; }
+.log-site-badge { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 8px; background: var(--blue); color: #fff; font-size: 10px; font-weight: 800; }
+.log-site b { display: block; font-size: 12px; }
+.log-site small { display: block; font-size: 10.5px; color: var(--muted); }
+.log-live { display: inline-flex; align-items: center; gap: 7px; flex: none; height: 30px; padding: 0 11px; border-radius: 999px; background: var(--green-soft); color: var(--green); font-size: 12px; font-weight: 700; }
