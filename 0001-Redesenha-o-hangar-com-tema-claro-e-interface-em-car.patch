diff --git a/src/projects/logistica/components/KpiCards.jsx b/src/projects/logistica/components/KpiCards.jsx
new file mode 100644
index 0000000..0e35775
--- /dev/null
+++ b/src/projects/logistica/components/KpiCards.jsx
@@ -0,0 +1,39 @@
+import { Boxes, Gauge, LayoutGrid, Package } from "lucide-react";
+
+// Indicadores do hangar calculados a partir do layout salvo.
+export default function KpiCards({ layout }) {
+  const slots = layout.kanbans.flatMap((k) => k.slots);
+  const filled = slots.filter((s) => s.code);
+  const occupancy = slots.length ? Math.round((filled.length / slots.length) * 100) : 0;
+  const materials = new Set(filled.map((s) => s.code.trim().toUpperCase())).size;
+  const units = filled.reduce((sum, s) => sum + (Number(s.qty) || 0), 0);
+
+  const cards = [
+    { icon: Boxes, label: "Caixas ocupadas", value: filled.length, sub: `de ${slots.length} posições` },
+    { icon: Gauge, label: "Ocupação", value: occupancy + "%", sub: "média dos kanbans", bar: occupancy },
+    { icon: Package, label: "Materiais", value: materials, sub: units.toLocaleString("pt-BR") + " unidades" },
+    { icon: LayoutGrid, label: "Kanbans", value: layout.kanbans.length, sub: `${layout.areas.length} áreas · ${layout.paths.length} caminhos` },
+  ];
+  return (
+    <div className="log-kpis">
+      {cards.map(({ icon: Icon, label, value, sub, bar }) => (
+        <div className="log-kpi" key={label}>
+          <span className="log-kpi-icon" aria-hidden="true">
+            <Icon size={17} />
+          </span>
+          <div>
+            <small>{label}</small>
+            <b>{value}</b>
+            {bar !== undefined ? (
+              <span className="log-kpi-bar" aria-hidden="true">
+                <i style={{ width: bar + "%" }} />
+              </span>
+            ) : (
+              <em>{sub}</em>
+            )}
+          </div>
+        </div>
+      ))}
+    </div>
+  );
+}
diff --git a/src/projects/logistica/components/ListCard.jsx b/src/projects/logistica/components/ListCard.jsx
new file mode 100644
index 0000000..13c2eb9
--- /dev/null
+++ b/src/projects/logistica/components/ListCard.jsx
@@ -0,0 +1,70 @@
+import { useState } from "react";
+import { ChevronRight } from "lucide-react";
+import { pathTypes } from "../constants.js";
+
+// Lista do layout em abas (canto inferior direito). Clicar seleciona e leva a câmera até o item.
+export default function ListCard({ layout, selected, onPick }) {
+  const [tab, setTab] = useState("kanbans");
+  const tabs = [
+    ["kanbans", "Kanbans", layout.kanbans.length],
+    ["areas", "Áreas", layout.areas.length],
+    ["paths", "Caminhos", layout.paths.length],
+  ];
+  let rows = [];
+  if (tab === "kanbans")
+    rows = layout.kanbans.map((k) => {
+      const used = k.slots.filter((s) => s.code).length;
+      const pct = Math.round((used / k.slots.length) * 100);
+      return {
+        id: k.id,
+        name: k.name,
+        sub: `${used} caixas ocupadas`,
+        pill: pct + "%",
+        tone: pct >= 75 ? "high" : pct > 0 ? "mid" : "low",
+        bar: pct,
+      };
+    });
+  if (tab === "areas") rows = layout.areas.map((a) => ({ id: a.id, name: a.name, sub: `${a.points.length} vértices`, pill: "Área", tone: "area" }));
+  if (tab === "paths")
+    rows = layout.paths.map((p) => ({
+      id: p.id,
+      name: p.name,
+      sub: `${pathTypes[p.type]?.label || "Rota logística"} · ${p.width} m`,
+      pill: p.type === "pedestrian" ? "Pessoas" : "Logística",
+      tone: p.type === "pedestrian" ? "road" : "route",
+    }));
+
+  return (
+    <section className="log-card log-list-card">
+      <div className="log-tabs" role="tablist">
+        {tabs.map(([key, label, count]) => (
+          <button key={key} role="tab" aria-selected={tab === key} className={tab === key ? "active" : ""} onClick={() => setTab(key)}>
+            {label} <em>{count}</em>
+          </button>
+        ))}
+      </div>
+      <div className="log-rows">
+        {rows.length ? (
+          rows.map((r) => (
+            <button key={r.id} className={"log-row" + (selected === r.id ? " active" : "")} onClick={() => onPick(r.id)}>
+              <span className="log-row-id">{r.id}</span>
+              <span className="log-row-main">
+                <b>{r.name}</b>
+                <small>{r.sub}</small>
+              </span>
+              {r.bar !== undefined && (
+                <span className="log-row-bar" aria-hidden="true">
+                  <i style={{ width: r.bar + "%" }} />
+                </span>
+              )}
+              <span className={"log-pill " + r.tone}>{r.pill}</span>
+              <ChevronRight size={15} className="log-row-chevron" />
+            </button>
+          ))
+        ) : (
+          <p className="log-empty">{tab === "areas" ? "Nenhuma área desenhada. Use a ferramenta Área." : "Nenhum caminho desenhado. Use a ferramenta Caminho."}</p>
+        )}
+      </div>
+    </section>
+  );
+}
